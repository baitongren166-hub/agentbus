{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentbus",
  "version": "0.6.0",
  "identifier": "app.agentbus.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
